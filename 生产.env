# =====================================================
# 限速网关配置模板（.env）
# 使用方法：cp .env.example .env 后按实际环境填写
# 优先级：环境变量 > .env 文件 > 代码默认值
# Redis / MySQL 均为外部服务，本项目不自带部署
# =====================================================

# ---- 服务 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_WORKERS=16

# ---- NewAPI 后端 ----
NEWAPI_BASE_URL=http://103.207.68.201:3000
NEWAPI_TIMEOUT=300

# ---- 外部 Redis ----
REDIS_HOST=redis-master
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_Redis_Strong_Pwd_2026
REDIS_DB=1
REDIS_POOL_SIZE=50

# ---- 外部 MySQL（网关自身的配置库）----
MYSQL_HOST=mysql-master
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=ChangeMe_Mysql_ROOT_Strong_Pwd_2026
MYSQL_DATABASE=ratelimit_gateway
MYSQL_POOL_SIZE=10
# 启动时自动建库+建表+种子数据（false 则需手动执行 sql/init.sql）
MYSQL_AUTO_INIT=true

# ---- NewAPI 数据库（只读，用于同步 Key->Group 映射）----
NEWAPI_MYSQL_HOST=mysql-master
NEWAPI_MYSQL_PORT=3306
NEWAPI_MYSQL_USER=newapi
NEWAPI_MYSQL_PASSWORD=ChangeMe_Mysql_Strong_Pwd_2026
NEWAPI_MYSQL_DATABASE=new-api
NEWAPI_MYSQL_POOL_SIZE=5

# ---- 同步 ----
SYNC_KEY_GROUP_INTERVAL=60
SYNC_CONFIG_CACHE_TTL=60
SYNC_KEY_MAP_TTL=300

# ---- 限速行为 ----
RATELIMIT_ON_KEY_NOT_FOUND=passthrough
RATELIMIT_ON_CONFIG_NOT_FOUND=passthrough
RATELIMIT_SHOW_REMAINING=true
# token 模式 + 流式请求时自动注入 stream_options.include_usage=true
RATELIMIT_AUTO_INJECT_INCLUDE_USAGE=true

# ---- Redis 故障降级 ----
# passthrough: 放行全部请求（可用性优先，限速失效）
# reject:      拒绝请求返回 503（保护上游优先）
# local_fallback: 进程内滑动窗口兜底限速（推荐）
RATELIMIT_ON_REDIS_ERROR=local_fallback
# 全局兜底参数（解析不到分组策略时使用）：窗口秒数 / 单 key 最大请求数
RATELIMIT_FALLBACK_WINDOW=60
RATELIMIT_FALLBACK_MAX_REQUESTS=60
# 分组感知兜底除数：Redis 故障时按「5h 限额 ÷ 除数」本地限速；0 = 自动用 SERVER_WORKERS
RATELIMIT_FALLBACK_LIMIT_DIVISOR=0

# ---- 熔断器（防 Redis 故障时逐请求等待超时导致延迟雪崩）----
RATELIMIT_CIRCUIT_BREAKER_ENABLED=true
# 连续失败多少次后熔断打开
RATELIMIT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# 熔断打开多少秒后半开探测恢复
RATELIMIT_CIRCUIT_BREAKER_OPEN_SECONDS=10

# ---- L1 进程内缓存（keymap/config：L1 → Redis → MySQL 读透）----
RATELIMIT_LOCAL_CACHE_SIZE=50000
RATELIMIT_LOCAL_CACHE_TTL=60
# 未找到的负缓存 TTL（防恶意 key 穿透到数据库）
RATELIMIT_LOCAL_CACHE_NEGATIVE_TTL=10

# ---- 请求数模式批量配额预取 ----
# 一次 EVALSHA 预取 N 个配额本地消耗，Redis QPS 降为 1/N；
# 多 worker 并发预取的超发上界约 (workers-1) × N
RATELIMIT_QUOTA_BATCH_SIZE=40

# ---- 管理后台 ----
ADMIN_ENABLED=true
# 生产环境必须改为强随机字符串
ADMIN_AUTH_TOKEN=tmalltmall
